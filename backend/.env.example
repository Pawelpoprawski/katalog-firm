# Environment Variables Template
# Copy this file to .env and fill in your actual values

# App Configuration
DEBUG=True
APP_NAME="Katalog Firm Polonijnych w Szwajcarii"

# CORS Configuration
# For development: use "*" to allow all origins
# For production: specify exact domains, e.g., "https://yourdomain.com,https://www.yourdomain.com"
CORS_ORIGINS=*

# Mapbox Token (optional - for map features)
MAPBOX_TOKEN=your_mapbox_token_here

# Security
# Generate a strong secret key for JWT tokens
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# Admin Panel Password (REQUIRED for production!)
# Set a strong password to protect admin endpoints
ADMIN_PASSWORD=your_admin_password_here

# Database (if migrating from JSON to SQL)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Google Maps API Key (recommended for accurate map pins)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

