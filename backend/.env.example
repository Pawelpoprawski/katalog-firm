# ============================================
# Backend - Zmienne srodowiskowe
# Skopiuj do .env i uzupelnij wartosci:
#   cp .env.example .env
# ============================================

# === WYMAGANE ===

# Haslo do panelu admina (ustaw silne haslo!)
ADMIN_PASSWORD=twoje_silne_haslo_admina

# Klucz do podpisywania tokenow JWT (min. 32 znaki)
# Wygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=wygeneruj_losowy_string_min_32_znakow

# Klucz API Google Maps (geocoding adresow)
# Uzyskaj na: https://console.cloud.google.com
# Wlacz: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=AIzaSy_twoj_klucz_google_maps

# === PRODUKCJA ===

# Tryb debug - ZAWSZE False na produkcji!
DEBUG=False

# Dozwolone domeny CORS (w produkcji NIE "*"!)
# Oddzielaj przecinkami: https://domena1.com,https://domena2.com
CORS_ORIGINS=https://polacyszwajcaria.com

# === OPCJONALNE ===

# Token Mapbox (nieuzywany, alternatywa dla Google Maps)
# MAPBOX_TOKEN=
