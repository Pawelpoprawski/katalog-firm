# ============================================
# Frontend - Zmienne srodowiskowe
# Skopiuj do .env.local i uzupelnij wartosci:
#   cp .env.example .env.local
# ============================================

# === WYMAGANE ===

# URL backendu API
# Development: http://localhost:8000
# Produkcja:   https://polacyszwajcaria.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000

# Klucz API Google Maps (mapa + autocomplete adresow)
# Uzyskaj na: https://console.cloud.google.com
# Wlacz: Maps JavaScript API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy_twoj_klucz_google_maps

# === OPCJONALNE ===

# Google Search Console - kod weryfikacyjny
# NEXT_PUBLIC_GOOGLE_VERIFICATION=twoj_kod_weryfikacyjny
